# =============================================================================
# NOGAL — Variables de entorno del backend (funciones Lambda)
# Copia este archivo a .env (NO lo subas al repo) o carga cada bloque en la
# consola de AWS Lambda → Configuration → Environment variables.
# Pon aquí SOLO valores de ejemplo. Los reales nunca van en el repo.
# =============================================================================

# -----------------------------------------------------------------------------
# erp-login — Auto-login de demo al ERP
# -----------------------------------------------------------------------------
# URL base del ERPNext (sin barra final). Usa HTTPS en producción.
ERP_URL=https://erp.theartificialmachine.com

# Credenciales de DEMO (académicas). Nunca en el frontend ni en el repo.
ERP_USERNAME=tu-usuario@dominio.com
ERP_PASSWORD=tu-password-aqui

# Dominio padre compartido por la Lambda y el ERP (con punto inicial).
# La Lambda debe publicarse en un subdominio de este dominio, p. ej.
# login.theartificialmachine.com, para que la cookie de sesión llegue al ERP.
COOKIE_DOMAIN=.theartificialmachine.com

# Origen de la landing (CloudFront). Se usa en las tres funciones.
ALLOW_ORIGIN=https://tu-distribucion.cloudfront.net

# Ruta del ERP a la que se llega tras iniciar sesión.
REDIRECT_PATH=/app

# -----------------------------------------------------------------------------
# catalog-stock — Stock en vivo para el catálogo
# -----------------------------------------------------------------------------
# API key/secret de un usuario de ERPNext con permisos de solo lectura sobre
# Bin (rol "Stock User" o uno propio). Se generan en: Usuario → API Access.
ERP_API_KEY=tu-api-key
ERP_API_SECRET=tu-api-secret
SKUS=MES-NOG,SIL-ROB,COM-CED,EST-NOG,ESC-ROB,TAB-STD
WAREHOUSE=
CACHE_SECONDS=60

# -----------------------------------------------------------------------------
# contact — Formulario de contacto (Amazon SES)
# -----------------------------------------------------------------------------
CONTACT_TO=ventas@nogal-muebles.com
CONTACT_FROM=no-reply@nogal-muebles.com
RATE_LIMIT=5
